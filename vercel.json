{
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "https://scvdvwryiuthnzwsyade.supabase.co/functions/v1/sitemap" },
    { "source": "/((?!assets/|.*\\.).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
